# ============================================================
# PlanFlow AI 环境变量模板
# 复制为 .env 并填入实际值
# ============================================================

# --- 认证（Auth.js v5 + 公开注册）---
# 会话签名密钥（JWT 加密），生产环境必须设置为强随机值
# 生成: openssl rand -base64 32
AUTH_SECRET=
# 种子管理员凭据（登录 / Prisma 模式首次登录自动 upsert 该用户）
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 生产环境（非 localhost）部署时必须为 true，放行 Auth.js 的 Host 校验
AUTH_TRUST_HOST=false

# --- 数据库 ---
# 运行时连接串（使用 Supabase Connection Pooling，端口 6543）
# Supabase 示例: postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres
# 本地 Docker:   postgresql://planflow:planflow@localhost:5432/planflow
DATABASE_URL=
# 直连连接串（Prisma 迁移/推送 schema 用，端口 5432）
# Supabase 示例: postgresql://postgres.[ref]:[pw]@db.[ref].supabase.co:5432/postgres
# 本地开发可留空，与 DATABASE_URL 相同
DIRECT_URL=

# --- 飞书日历集成 ---
# 飞书开放平台应用凭证: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 日历提供方: mock_feishu | feishu
CALENDAR_PROVIDER=feishu

# --- AI 规划服务 ---
# AI 提供方: mock | openai_compatible
AI_PROVIDER=mock
# OpenAI 兼容接口配置（AI_PROVIDER=openai_compatible 时必填）
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
